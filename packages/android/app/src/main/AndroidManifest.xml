<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Reaching Google Drive. The vault itself works offline; this is only
         ever used to publish and fetch the encrypted backup. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Package visibility (Android 11+). Without this the platform hides every
         other app from us, and `resolveActivity` for an https VIEW intent comes
         back null however many browsers are installed — which reads as "no
         browser found" and dead-ends the Drive grant. Declaring the intent we
         actually dispatch is what makes browsers visible to resolve against. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Keyweb">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Sharing links, so tapping one somebody sent opens Keyweb rather
              than the web app.

              `autoVerify` asks Android to check for an assetlinks.json naming
              this app at the root of keyneom.github.io. That file lives in the
              repository that serves the domain root, not in this one, and it
              now names this package and its signing certificate — so these are
              verified links and open the app directly.

              If the signing key ever changes, that file has to change with it
              on the same day, or every link silently goes back to opening the
              website. The fingerprint is the app's, not the key's name, so a
              re-signed build is a different app as far as Android is
              concerned. Before it was published, Android treated these as
              unverified: they did not open the app on Android 12 and later
              unless the person turned
              it on under "Open by default".

              That is why the keyrings screen also takes a pasted link. It is
              not a fallback for an error — it is the path that works on every
              phone today, and it stays whatever the verification does.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="keyneom.github.io"
                    android:pathPrefix="/keyweb/" />
            </intent-filter>
        </activity>

        <!--
          Filling passwords into other apps and the browser.

          The service holds no key and reads nothing: it offers a single
          "Unlock Keyweb" row, and the activity below is where the device lock
          is checked and the vault is actually opened. BIND_AUTOFILL_SERVICE
          is held by the system, not requested by us — it is what stops any
          other app binding to this service.
        -->
        <service
            android:name=".autofill.KeywebAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
        </service>

        <!--
          The same thing for apps that ask through Credential Manager rather
          than by showing a form. Android 14 and later only; the system simply
          does not bind it on older releases, where the autofill service above
          is the whole answer.
        -->
        <service
            android:name=".autofill.KeywebCredentialService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider" />
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
        </service>

        <activity
            android:name=".autofill.CredentialUnlockActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <!--
          Launched only by the platform, with the request it is answering.
          Not exported: nothing else has any business starting it.
        -->
        <activity
            android:name=".autofill.AutofillUnlockActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true" />

    </application>
</manifest>
