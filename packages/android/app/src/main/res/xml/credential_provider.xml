<?xml version="1.0" encoding="utf-8"?>
<!--
  What Keyweb can answer for.

  Passwords only, and that is a complete answer rather than a partial one: a
  provider declares the credential types it handles and the system asks it for
  those. Passkeys are absent because Keyweb does not store them yet, not
  because a password manager cannot; federated sign-in belongs to identity
  providers and never will be ours.
-->
<credential-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="app.keyweb.MainActivity">
    <capabilities>
        <!--
          The framework's own type string, which is what the system matches
          against. It is "android.credentials...", not "androidx.credentials..."
          despite the provider API living in androidx: the androidx constant's
          *value* is the framework one. Getting this wrong is silent — the
          service installs, registers, and can be selected, and the system then
          logs "does not have the required capabilities" and never calls it.
        -->
        <capability name="android.credentials.TYPE_PASSWORD_CREDENTIAL" />
    </capabilities>
</credential-provider>
