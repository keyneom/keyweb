# Google Cloud configuration for encrypted Drive backup and sharing.
#
# None of these are secrets: a browser app ships all three to every visitor.
# What protects the vault is that Drive only ever holds ciphertext, and that
# the API key and OAuth client are restricted to Keyweb's own origins. In CI
# they are GitHub repository *variables*, not secrets, matching easy-bc.
#
# Copy to .env.local and fill in. Backup stays off until the client id is set,
# and the app says so on screen rather than implying it is backing up.

# Cloud project number (NOT the project id). Google Picker's setAppId.
VITE_GOOGLE_CLOUD_PROJECT_NUMBER=955764773685

# OAuth 2.0 client id, type "Web application".
VITE_GOOGLE_WEB_CLIENT_ID=

# API key restricted to the Drive and Picker APIs. Picker's developerKey.
VITE_GOOGLE_API_KEY=
